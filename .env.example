# Copia a .env (cp .env.example .env). Una variable vacía toma el default del código.

# Key de Anthropic. Vacía a propósito: sin ella el servicio arranca y los casos van a revisión humana.
ANTHROPIC_API_KEY=
# Modelo del agente (default: claude-opus-5-5).
MODEL=claude-opus-5-5
# Esfuerzo del modelo: low, medium, high, xhigh o max (default: medium).
EFFORT=medium
# Máximo de tokens de salida por paso del modelo (default: 16000).
MAX_OUTPUT_TOKENS=
# Timeout por llamada al modelo, en segundos (default: 120).
LLM_TIMEOUT_S=
# Precio por millón de tokens de entrada, en USD, para el costo en la traza (default: 4.0, Opus 5.5).
PRICE_INPUT_PER_MTOK=
# Precio por millón de tokens de salida, en USD (default: 20.0, Opus 5.5).
PRICE_OUTPUT_PER_MTOK=
# Presupuesto de llamadas a tools por caso; excedido, el caso va a humano (default: 6).
MAX_TOOL_STEPS=6
# Presupuesto de tokens por caso; excedido, el caso va a humano (default: 30000).
MAX_CASE_TOKENS=30000
